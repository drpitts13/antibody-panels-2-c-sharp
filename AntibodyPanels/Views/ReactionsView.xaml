<UserControl x:Class="AntibodyPanels.Views.ReactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AntibodyPanels.ViewModels"
             xmlns:views="clr-namespace:AntibodyPanels.Views">
    <UserControl.Resources>
        <!-- Header template for antigen columns — binds to AntigenColumnHeader objects -->
        <DataTemplate x:Key="AntigenHeaderTemplate" DataType="{x:Type views:AntigenColumnHeader}">
            <TextBlock Text="{Binding Antigen}" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRuledOut}" Value="True">
                                <Setter Property="Foreground" Value="#C62828"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="ToolTip" Value="Ruled out for this specimen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDestroyed}" Value="True">
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                <Setter Property="ToolTip" Value="Antigen destroyed by cell treatment"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <!-- Row 1: Specimen + Panel selectors -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Find:" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding SpecimenFilter, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,2"
                     ToolTip="Filter the specimen list by accession, type, phenotype, previous antibodies, notes, or final ID"/>
            <Label Content="Specimen:" Grid.Column="3" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="4" ItemsSource="{Binding Specimens}"
                      SelectedItem="{Binding SelectedSpecimen}"
                      DisplayMemberPath="AccessionNumber"
                      IsEditable="True" IsTextSearchEnabled="True"/>
            <Label Content="Panel:" Grid.Column="6" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="7" ItemsSource="{Binding Panels}"
                      SelectedItem="{Binding SelectedPanel}"
                      DisplayMemberPath="Name"
                      IsEditable="True" IsTextSearchEnabled="True"/>
        </Grid>

        <!-- Row 2: Run selector + action buttons -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="Run:" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Runs}"
                      SelectedItem="{Binding SelectedRun}"
                      DisplayMemberPath="DisplayLabel"/>
            <Button Grid.Column="2" Content="+ Run" Command="{Binding AddRunCommand}"
                    Margin="6,0,4,0" Padding="6,2"
                    ToolTip="Add a new special-panel run (enzyme, DTT, absorption, etc.)"/>
            <Button Grid.Column="3" Content="Delete Run" Command="{Binding DeleteRunCommand}"
                    Margin="0,0,4,0" Padding="6,2"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                <CheckBox Content="Compare" IsChecked="{Binding CompareMode}"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Show another run's grades beside this one"/>
                <ComboBox ItemsSource="{Binding CompareRunChoices}"
                          SelectedItem="{Binding CompareRun}"
                          DisplayMemberPath="DisplayLabel"
                          Width="160"
                          Visibility="{Binding ComparePanelVisibility}"
                          ToolTip="Run to compare against"/>
                <CheckBox Content="Hide ruled-out" IsChecked="{Binding HideRuledOutAntigenColumns}"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Hide antigen columns already ruled out for this specimen"/>
            </StackPanel>
            <Button Grid.Column="5" Content="Load Reactions" Command="{Binding LoadCommand}"
                    Margin="4,0,4,0" Padding="8,2"/>
            <Button Grid.Column="6" Content="Save" Command="{Binding SaveCommand}"
                    Margin="0,0,4,0" Padding="8,2"
                    ToolTip="Save grades without running analysis (Ctrl+S)"/>
            <Button Grid.Column="7" Content="Save &amp; Analyze" Command="{Binding SaveAnalyzeCommand}"
                    Margin="0,0,4,0" Padding="8,2" FontWeight="Bold"/>
            <Button Grid.Column="8" Content="Fill 0s" Command="{Binding FillNegativesCommand}"
                    Margin="0,0,4,0" Padding="8,2"
                    ToolTip="Set remaining NT phases to 0. Check cells become 2+ when AHG is 0. Does not overwrite grades already entered."/>
            <Button Grid.Column="9" Content="Clear" Command="{Binding ClearCommand}" Padding="8,2"/>
        </Grid>

        <!-- Treatment banner (visible only for special runs) -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding TreatmentBannerVisibility}"
                Background="#E3F2FD" BorderBrush="#1565C0" BorderThickness="0,0,0,2"
                CornerRadius="3" Padding="10,5" Margin="0,0,0,5">
            <TextBlock Text="{Binding TreatmentBannerText}"
                       Foreground="#0D47A1" FontStyle="Italic" FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Save & Analyze status banner -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding SaveStatusVisibility}"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#B71C1C"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SaveStatusIsSuccess}" Value="True">
                            <Setter Property="Background" Value="#1B5E20"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#x2717;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveStatusIsSuccess}" Value="True">
                                    <Setter Property="Text" Value="&#x2713;"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding SaveStatusMessage}" Foreground="White"
                           FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Reaction DataGrid — antigen columns injected in code-behind -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <DataGrid x:Name="ReactionsGrid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  SelectionUnit="Cell" FontSize="12"
                  FrozenColumnCount="1"
                  Loaded="ReactionsGrid_Loaded"
                  PreviewKeyDown="ReactionsGrid_PreviewKeyDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                            <Setter Property="Background" Value="#BBDEFB"/>
                            <Setter Property="ToolTip" Value="No grades entered yet"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasRuleout}" Value="True">
                            <Setter Property="Background" Value="#DCEDC8"/>
                            <Setter Property="ToolTip" Value="{Binding RuledOutNote}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cell" Binding="{Binding CellNumber}"
                                    Width="48" IsReadOnly="True"/>
                <!-- antigen columns inserted here by code-behind -->
                <DataGridComboBoxColumn Header="IS" Width="72"
                    SelectedItemBinding="{Binding IS, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{x:Static local:ReactionsViewModel.ReactionValues}"/>
                <DataGridComboBoxColumn Header="37°C" Width="72"
                    SelectedItemBinding="{Binding C37, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{x:Static local:ReactionsViewModel.ReactionValues}"/>
                <DataGridComboBoxColumn Header="AHG" Width="72"
                    SelectedItemBinding="{Binding AHG, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{x:Static local:ReactionsViewModel.ReactionValues}"/>
                <DataGridComboBoxColumn Header="CC" Width="72"
                    SelectedItemBinding="{Binding CC, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{x:Static local:ReactionsViewModel.ReactionValues}"/>
                <!-- Ruled Out column appended after antigens in code-behind -->
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Grid.Row="1" Margin="0,4,0,2" Foreground="#546E7A" FontSize="11"
                       TextWrapping="Wrap">
                <Run Text="{Binding EntryProgressText, Mode=OneWay}"/>
                <Run Text="  Keys: 0–4 = grade, N = NT, Enter = next phase. Colors: incomplete blue, 1+ yellow, 2+ orange, 3+/4+ red. Pink CC = invalid when AHG is 0."/>
            </TextBlock>
            <DataGrid x:Name="CompareGrid" Grid.Row="2" Margin="0,4,0,0"
                      ItemsSource="{Binding CompareRows}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="All" HeadersVisibility="Column"
                      FontSize="12" MaxHeight="220"
                      Visibility="{Binding ComparePanelVisibility}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AnyChanged}" Value="True">
                                <Setter Property="Background" Value="#FFF8E1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cell" Binding="{Binding CellNumber}" Width="48"/>
                    <DataGridTextColumn Header="This IS" Binding="{Binding LeftIS}" Width="70"/>
                    <DataGridTextColumn Header="Other IS" Binding="{Binding RightIS}" Width="70"/>
                    <DataGridTextColumn Header="This 37°C" Binding="{Binding LeftC37}" Width="78"/>
                    <DataGridTextColumn Header="Other 37°C" Binding="{Binding RightC37}" Width="78"/>
                    <DataGridTextColumn Header="This AHG" Binding="{Binding LeftAHG}" Width="78"/>
                    <DataGridTextColumn Header="Other AHG" Binding="{Binding RightAHG}" Width="78"/>
                    <DataGridTextColumn Header="This CC" Binding="{Binding LeftCC}" Width="70"/>
                    <DataGridTextColumn Header="Other CC" Binding="{Binding RightCC}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Changed" Binding="{Binding AnyChanged}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
