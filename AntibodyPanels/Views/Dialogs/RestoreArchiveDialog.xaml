<Window x:Class="AntibodyPanels.Views.Dialogs.RestoreArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Archive" Width="640" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinWidth="520" MinHeight="400">
    <DockPanel Margin="16,12,16,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Read a purged-data archive, then restore missing specimens into the live database."
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Browse..." Width="88" Margin="8,0,0,0"
                        Click="BrowseClick"/>
                <TextBox x:Name="PathBox" IsReadOnly="True" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RestoreButton" Content="Restore" Width="88" Margin="0,0,8,0"
                    Click="RestoreClick" IsEnabled="False" IsDefault="True"/>
            <Button Content="Close" Width="88" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="SpecimenGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Accession" Binding="{Binding AccessionNumber}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
