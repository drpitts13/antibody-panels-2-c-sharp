<Window x:Class="AntibodyPanels.Views.Dialogs.DownloadFromVendorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download panel from vendor" Height="520" Width="780"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Vendor:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="VendorBox" Width="260" SelectionChanged="VendorBox_SelectionChanged"/>
            <Button Content="Refresh lots" Width="110" Margin="12,0,0,0"
                    Click="RefreshClick" x:Name="RefreshButton"/>
            <Button Content="Import vendor file…" Width="150" Margin="8,0,0,0"
                    Click="ImportFileClick"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="#546E7A"
                   Text="Select a vendor and refresh the public lot catalog, or import a PDF/CSV you already downloaded."/>

        <DataGrid x:Name="LotGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductLine}" Width="*"/>
                <DataGridTextColumn Header="Lot" Binding="{Binding LotNumber}" Width="120"/>
                <DataGridTextColumn Header="Expires" Binding="{Binding DisplayExpiration}" Width="100"/>
                <DataGridTextColumn Header="Catalog" Binding="{Binding CatalogNumber}" Width="80"/>
                <DataGridCheckBoxColumn Header="Enz." Binding="{Binding EnzymeTreated}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="HintText" Grid.Row="3" TextWrapping="Wrap" Margin="0,8,0,8"
                   Foreground="#78909C"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Import selected" Width="130" Margin="0,0,8,0"
                    Click="ImportSelectedClick" IsDefault="True" x:Name="ImportSelectedButton"/>
            <Button Content="Close" Width="84" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
