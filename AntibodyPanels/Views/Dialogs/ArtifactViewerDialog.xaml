<Window x:Class="AntibodyPanels.Views.Dialogs.ArtifactViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imported source artifact" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" MinHeight="280">
    <DockPanel Margin="16,12,16,12">
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6"
                   Text="Review the original import file. This is evidence, not a diagnosis."/>
        <TextBox x:Name="StatusBox" DockPanel.Dock="Top" IsReadOnly="True" TextWrapping="Wrap"
                 Margin="0,0,0,8" MinHeight="56" FontSize="13"/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="SHA-256:" VerticalAlignment="Center"/>
            <TextBox x:Name="HashBox" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="Path:" VerticalAlignment="Center"/>
            <TextBox x:Name="PathBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,2"
                     TextWrapping="Wrap"/>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="Preview (text files only):" Margin="0,0,0,4"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Open file" Width="100" Margin="0,0,8,0" Click="OpenFileClick" x:Name="OpenFileButton"/>
            <Button Content="Open folder" Width="100" Margin="0,0,8,0" Click="OpenFolderClick" x:Name="OpenFolderButton"/>
            <Button Content="Copy hash" Width="90" Margin="0,0,8,0" Click="CopyHashClick"/>
            <Button Content="Close" Width="84" IsCancel="True" IsDefault="True"/>
        </StackPanel>
        <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12" MinHeight="140" MaxHeight="260"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"/>
    </DockPanel>
</Window>
