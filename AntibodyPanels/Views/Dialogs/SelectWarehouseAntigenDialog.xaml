<Window x:Class="AntibodyPanels.Views.Dialogs.SelectWarehouseAntigenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add antigen" Height="420" Width="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Select one or more non-standard antigens to add to this panel. They will appear as extra columns and are considered for antibody identification only on panels that type them."/>
        <ListBox x:Name="AntigenList" Grid.Row="1" SelectionMode="Extended"
                 DisplayMemberPath="DisplayLabel"
                 MouseDoubleClick="AntigenList_DoubleClick"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Add" Width="80" Margin="0,0,8,0" Click="OkClick" IsDefault="True"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
