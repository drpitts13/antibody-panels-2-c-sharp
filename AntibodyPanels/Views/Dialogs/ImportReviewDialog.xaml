<Window x:Class="AntibodyPanels.Views.Dialogs.ImportReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review imported panel" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="16,12,16,12">
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"
                   Text="Imported panels stay inactive until a qualified user reviews them."/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#555"
                   Text="Scores and rule-outs are analytical evidence, not a diagnosis. Activate only after you confirm the antigram and lot metadata."/>
        <TextBox x:Name="ReviewBox" DockPanel.Dock="Top" MinHeight="140" MaxHeight="260"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12" FontFamily="Segoe UI" FontSize="13"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Activate now" Width="120" Margin="0,0,8,0" IsDefault="True" Click="ActivateClick"/>
            <Button Content="Keep inactive" Width="120" IsCancel="True" Click="KeepInactiveClick"/>
        </StackPanel>
    </DockPanel>
</Window>
