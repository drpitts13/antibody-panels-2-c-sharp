<Window x:Class="AntibodyPanels.Views.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Preferences" SizeToContent="WidthAndHeight" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16,12,16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Label Content="Lab name:" Grid.Row="0" VerticalAlignment="Center"/>
            <TextBox x:Name="LabNameBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Department:" Grid.Row="1" VerticalAlignment="Center"/>
            <TextBox x:Name="DepartmentBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Score threshold:" Grid.Row="2" VerticalAlignment="Center"
                   ToolTip="Minimum combined score to list an antibody as suspected (0.30–0.95)."/>
            <TextBox x:Name="ThresholdBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="ID cell rule:" Grid.Row="3" VerticalAlignment="Center"
                   ToolTip="Minimum antigen-positive reactive cells and antigen-negative nonreactive cells required to identify an antibody (AABB 3 + 3 is the usual standard)."/>
            <ComboBox x:Name="IdRuleBox" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="ACS rule-outs:" Grid.Row="4" VerticalAlignment="Center"
                   ToolTip="Minimum times each clinically significant antibody must be ruled out before suggesting All Clinically Significant Antibodies Ruled Out (1–5)."/>
            <TextBox x:Name="AcsRuleoutBox" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Default rule-outs:" Grid.Row="5" VerticalAlignment="Center"
                   ToolTip="Minimum qualifying antigen-positive nonreactive cells required to rule out an antibody when no per-antibody rule exists (1–5). A rule on the Rules tab overrides this for that antibody."/>
            <TextBox x:Name="DefaultRuleoutBox" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Default specimen type:" Grid.Row="6" VerticalAlignment="Center"/>
            <ComboBox x:Name="DefaultTypeBox" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Specimen dating (days):" Grid.Row="7" VerticalAlignment="Center"
                   ToolTip="Pre-fill expiration when adding a specimen. 0 = leave blank. Typical antibody workup dating is 3 days."/>
            <TextBox x:Name="DatingDaysBox" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Expiration warning (days):" Grid.Row="8" VerticalAlignment="Center"/>
            <TextBox x:Name="ExpiryDaysBox" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Max database size (MB):" Grid.Row="9" VerticalAlignment="Center"
                   ToolTip="Warn when the database file reaches 80% of this size. Allowed range: 50–10240 MB."/>
            <TextBox x:Name="MaxDbSizeBox" Grid.Row="9" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Default initials:" Grid.Row="10" VerticalAlignment="Center"
                   ToolTip="Pre-filled on Confirm ID. Updated automatically when you confirm an identification."/>
            <TextBox x:Name="InitialsBox" Grid.Row="10" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"
                     MaxLength="12"/>

            <CheckBox x:Name="ShowInactiveCheck" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Show inactive specimens and panels by default"
                      VerticalAlignment="Center" Margin="4,0,0,0"/>

            <CheckBox x:Name="HideRuledOutCheck" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Hide ruled-out antigen columns on the Reactions tab"
                      VerticalAlignment="Center" Margin="4,0,0,0"/>

            <Label Content="Extra phases:" Grid.Row="13" VerticalAlignment="Center"
                   ToolTip="Optional extra reaction columns. Leave blank for the classic IS / 37°C / AHG / CC grid. Gel, Solid, and PEG count as IAT-like evidence. Dil1–Dil128 are serial-dilution titer columns, not identification phases."/>
            <TextBox x:Name="ExtraPhasesBox" Grid.Row="13" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"
                     ToolTip="Suggested: RT, PEG, Gel, Solid, and optional Dil1–Dil128. Custom names are kept. Dilution columns are not IAT."
                     TextChanged="ExtraPhasesBox_TextChanged"/>

            <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        Margin="4,0,0,0">
                <CheckBox x:Name="PhaseRtCheck" Content="RT" Margin="0,0,12,0"
                          VerticalAlignment="Center" Checked="SuggestedPhaseChanged" Unchecked="SuggestedPhaseChanged"/>
                <CheckBox x:Name="PhasePegCheck" Content="PEG" Margin="0,0,12,0"
                          VerticalAlignment="Center" Checked="SuggestedPhaseChanged" Unchecked="SuggestedPhaseChanged"/>
                <CheckBox x:Name="PhaseGelCheck" Content="Gel" Margin="0,0,12,0"
                          VerticalAlignment="Center" Checked="SuggestedPhaseChanged" Unchecked="SuggestedPhaseChanged"/>
                <CheckBox x:Name="PhaseSolidCheck" Content="Solid" Margin="0,0,12,0"
                          VerticalAlignment="Center" Checked="SuggestedPhaseChanged" Unchecked="SuggestedPhaseChanged"
                          ToolTip="Solid-phase / Capture IAT column. Counts as IAT-like, not a diagnosis."/>
            </StackPanel>

            <CheckBox x:Name="PhaseTiterGridCheck"
                      Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Titer grid (Dil1–Dil128)"
                      VerticalAlignment="Center" Margin="4,0,0,0"
                      ToolTip="Adds serial-dilution columns. Last reactive tube is the titer endpoint. These grades are not IAT and do not rule out or identify an antibody."
                      Checked="SuggestedPhaseChanged" Unchecked="SuggestedPhaseChanged"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" Width="84" Margin="0,0,8,0" Click="SaveClick" IsDefault="True"/>
            <Button Content="Cancel" Width="84" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
