<Window x:Class="AntibodyPanels.Views.Dialogs.PanelRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Panel Run" SizeToContent="WidthAndHeight" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16,12,16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Label Content="Cell Treatment:" Grid.Row="0" VerticalAlignment="Center"/>
            <ComboBox x:Name="CellTreatmentBox" Grid.Row="0" Grid.Column="1"
                      VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Serum Treatment:" Grid.Row="1" VerticalAlignment="Center"/>
            <ComboBox x:Name="SerumTreatmentBox" Grid.Row="1" Grid.Column="1"
                      VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Label (optional):" Grid.Row="2" VerticalAlignment="Center"/>
            <TextBox x:Name="LabelBox" Grid.Row="2" Grid.Column="1"
                     VerticalAlignment="Center" Margin="0,2"
                     ToolTip="Leave blank to auto-generate from selected treatments"/>
        </Grid>

        <TextBlock x:Name="InfoText" FontStyle="Italic" Foreground="#555"
                   FontSize="11" Margin="0,8,0,4" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Add Run" Width="90" Margin="0,0,8,0"
                    Click="SaveClick" IsDefault="True"/>
            <Button Content="Cancel" Width="84" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
