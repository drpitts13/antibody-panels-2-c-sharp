<UserControl x:Class="AntibodyPanels.Views.WorklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashCard" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Worklist" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#546E7A"/>
                <TextBox Width="180" Margin="0,0,12,0" VerticalAlignment="Center"
                         Text="{Binding ListFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by accession, panel name, kind, urgency, or detail"/>
                <Button Content="Show all" Command="{Binding ShowAllCommand}" Padding="10,2" Margin="0,0,8,0"
                        ToolTip="Show every worklist category"/>
                <Button Content="Open" Command="{Binding OpenCommand}" Padding="10,2" Margin="0,0,8,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,2"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,8">
            <Button Style="{StaticResource DashCard}" Margin="0,0,8,0" Background="#FFECB3"
                    Command="{Binding IsolateKindCommand}" CommandParameter="Incomplete"
                    ToolTip="Click to show only incomplete work. Click again to show all.">
                <StackPanel>
                    <TextBlock Text="Incomplete" FontSize="11" Foreground="#5D4037"/>
                    <TextBlock Text="{Binding IncompleteCount}" FontSize="22" FontWeight="Bold" Foreground="#E65100"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DashCard}" Margin="0,0,8,0" Background="#FFE0B2"
                    Command="{Binding IsolateKindCommand}" CommandParameter="Stale"
                    ToolTip="Click to show only stale analyses. Click again to show all.">
                <StackPanel>
                    <TextBlock Text="Stale analysis" FontSize="11" Foreground="#5D4037"/>
                    <TextBlock Text="{Binding StaleCount}" FontSize="22" FontWeight="Bold" Foreground="#EF6C00"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DashCard}" Margin="0,0,8,0" Background="#FFF9C4"
                    Command="{Binding IsolateKindCommand}" CommandParameter="Expiring"
                    ToolTip="Click to show only items nearing expiration. Click again to show all.">
                <StackPanel>
                    <TextBlock Text="Expiring" FontSize="11" Foreground="#5D4037"/>
                    <TextBlock Text="{Binding ExpiringCount}" FontSize="22" FontWeight="Bold" Foreground="#F9A825"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DashCard}" Margin="0" Background="#FFCDD2"
                    Command="{Binding IsolateKindCommand}" CommandParameter="Expired"
                    ToolTip="Click to show only expired specimens and panels. Click again to show all.">
                <StackPanel>
                    <TextBlock Text="Expired" FontSize="11" Foreground="#5D4037"/>
                    <TextBlock Text="{Binding ExpiredCount}" FontSize="22" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#546E7A"/>
            <CheckBox Content="Incomplete" IsChecked="{Binding ShowIncomplete}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox Content="Stale analysis" IsChecked="{Binding ShowStale}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox Content="Expiring" IsChecked="{Binding ShowExpiring}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox Content="Expired" IsChecked="{Binding ShowExpired}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#546E7A" TextWrapping="Wrap"
                   Text="Incomplete reactions and stale analyses for specimens that do not yet have a confirmed antibody ID, plus specimens or panels that are expired or nearing expiration. Click a count card to filter. Double-click or press Enter on a row to open it."/>
        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  MouseDoubleClick="WorklistGrid_MouseDoubleClick"
                  PreviewKeyDown="WorklistGrid_PreviewKeyDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="ExpiredSpecimen">
                            <Setter Property="Background" Value="#FFCDD2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="ExpiredPanel">
                            <Setter Property="Background" Value="#FFCDD2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="IncompleteReactions">
                            <Setter Property="Background" Value="#FFECB3"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="StaleAnalysis">
                            <Setter Property="Background" Value="#FFE0B2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="ExpiringSpecimen">
                            <Setter Property="Background" Value="#FFF9C4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="ExpiringPanel">
                            <Setter Property="Background" Value="#FFF9C4"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind" Binding="{Binding KindLabel}" Width="140"/>
                <DataGridTextColumn Header="Urgency" Binding="{Binding UrgencyLabel}" Width="100"/>
                <DataGridTextColumn Header="Item" Binding="{Binding Title}" Width="180"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
