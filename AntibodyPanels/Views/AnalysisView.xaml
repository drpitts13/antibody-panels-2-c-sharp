<UserControl x:Class="AntibodyPanels.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AntibodyPanels.Views">
    <DockPanel Margin="8">
        <!-- Top selector -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="Find:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding SpecimenFilter, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,2"
                     ToolTip="Filter specimens by accession, type, phenotype, previous antibodies, notes, or final ID"/>
            <Label Grid.Column="3" Content="Specimen:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="4" ItemsSource="{Binding Specimens}"
                      SelectedItem="{Binding SelectedSpecimen}"
                      DisplayMemberPath="ListDisplay"
                      IsEditable="True" IsTextSearchEnabled="True"/>
            <TextBlock Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center"
                       Text="⚠ Analysis is stale — reactions have been updated since last analysis."
                       Foreground="OrangeRed" FontWeight="Bold"
                       Visibility="{Binding IsStale, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
            <Button Grid.Column="6" Content="Enter Reactions" Command="{Binding OpenReactionsCommand}"
                    Padding="10,2" Margin="0,0,6,0"
                    ToolTip="Open this specimen on the Reactions tab"/>
            <Button Grid.Column="7" Content="Clinical Report" Command="{Binding OpenReportCommand}"
                    Padding="10,2" Margin="0,0,6,0"
                    ToolTip="Open the clinical identification report for this specimen"/>
            <Button Grid.Column="8" Content="Run Analysis" Command="{Binding AnalyzeCommand}"
                    Padding="10,2" FontWeight="Bold"/>
        </Grid>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6" Background="#FFF8E1" BorderBrush="#F9A825"
                BorderThickness="1" CornerRadius="3"
                Visibility="{Binding HasSuggestions, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Suggestions" FontWeight="Bold" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding SuggestionItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Inner tabs -->
        <TabControl>
            <TabItem Header="Suspected Antibodies">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding SuspectedRows}"
                              SelectedItem="{Binding SelectedSuspected}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              MouseDoubleClick="SuspectedGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MeetsIdentificationRule}" Value="True">
                                        <Setter Property="Background" Value="#C8E6C9"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="ToolTip" Value="Meets the identification cell rule. Double-click to add to Final ID."/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MeetsIdentificationRule}" Value="False">
                                        <Setter Property="Background" Value="#FFF8E1"/>
                                        <Setter Property="ToolTip" Value="Does not yet meet the identification cell rule. Double-click to add to Final ID anyway."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Antibody" Binding="{Binding Antibody}" Width="*"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="80"/>
                            <DataGridTextColumn Header="Fisher p-value" Binding="{Binding FisherPValue}" Width="100"/>
                            <DataGridTextColumn Header="Pattern Score" Binding="{Binding PatternScore}" Width="100"/>
                            <DataGridTextColumn Header="Ag+ reactive" Binding="{Binding AgPositiveReactive}" Width="100"/>
                            <DataGridTextColumn Header="Ag- nonreactive" Binding="{Binding AgNegativeNonreactive}" Width="120"/>
                            <DataGridTextColumn Header="ID rule" Binding="{Binding IdentificationRule}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Supporting cells" FontWeight="SemiBold" Margin="4,2"/>
                            <DataGrid ItemsSource="{Binding SupportingCells}" IsReadOnly="True"
                                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Panel" Binding="{Binding PanelName}" Width="*"/>
                                    <DataGridTextColumn Header="Run" Binding="{Binding RunLabel}" Width="90"/>
                                    <DataGridTextColumn Header="Cell" Binding="{Binding CellNumber}" Width="50"/>
                                    <DataGridTextColumn Header="IS" Binding="{Binding IS}" Width="40"/>
                                    <DataGridTextColumn Header="37°C" Binding="{Binding C37}" Width="45"/>
                                    <DataGridTextColumn Header="AHG" Binding="{Binding AHG}" Width="45"/>
                                    <DataGridTextColumn Header="Strongest" Binding="{Binding Strongest}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Conflicting cells (Ag− but reactive)" FontWeight="SemiBold" Margin="4,2"/>
                            <DataGrid ItemsSource="{Binding ConflictingCells}" IsReadOnly="True"
                                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Panel" Binding="{Binding PanelName}" Width="*"/>
                                    <DataGridTextColumn Header="Run" Binding="{Binding RunLabel}" Width="90"/>
                                    <DataGridTextColumn Header="Cell" Binding="{Binding CellNumber}" Width="50"/>
                                    <DataGridTextColumn Header="IS" Binding="{Binding IS}" Width="40"/>
                                    <DataGridTextColumn Header="37°C" Binding="{Binding C37}" Width="45"/>
                                    <DataGridTextColumn Header="AHG" Binding="{Binding AHG}" Width="45"/>
                                    <DataGridTextColumn Header="Strongest" Binding="{Binding Strongest}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                    <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,6" Background="#E8F5E9" BorderBrush="#2E7D32"
                            BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="9" Text="{Binding FinalCallStatus}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Label Grid.Row="1" Content="Final ID:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FinalAntibodiesText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,2,8,2"
                                     ToolTip="Confirmed antibody identification, e.g. anti-E; anti-K. Green suspected rows are pre-filled when they meet the ID rule."/>
                            <Label Grid.Row="1" Grid.Column="2" Content="Comment:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding FinalComment, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,2,8,2"/>
                            <Label Grid.Row="1" Grid.Column="4" Content="Initials:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding IdentifiedBy, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,2,8,2"/>
                            <Button Grid.Row="1" Grid.Column="6" Content="Add selected" Command="{Binding AddSelectedToFinalIdCommand}"
                                    Margin="0,0,6,0"
                                    ToolTip="Add the highlighted suspected antibody to Final ID"/>
                            <Button Grid.Row="1" Grid.Column="7" Content="Confirm ID" Command="{Binding ConfirmIdCommand}"
                                    Margin="0,0,6,0" FontWeight="Bold"/>
                            <Button Grid.Row="1" Grid.Column="8" Content="Clear" Command="{Binding ClearConfirmationCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Ruled Out">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding RuleoutRows}"
                              SelectedItem="{Binding SelectedRuleout}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MeetsRequired}" Value="True">
                                        <Setter Property="Background" Value="#C8E6C9"/>
                                        <Setter Property="ToolTip" Value="Rule-out count meets the lab ACS target."/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding MeetsRequired}" Value="False"/>
                                            <Condition Binding="{Binding IsClinicallySignificant}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#FFF8E1"/>
                                        <Setter Property="ToolTip" Value="Clinically significant antibody still short of the ACS rule-out count."/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Antibody" Binding="{Binding Antibody}" Width="*"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
                            <DataGridTextColumn Header="Needed" Binding="{Binding Required}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="Cells that counted toward this rule-out" FontWeight="SemiBold" Margin="4,2"/>
                        <DataGrid ItemsSource="{Binding RuleoutDetailRows}" IsReadOnly="True"
                                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Panel" Binding="{Binding PanelName}" Width="*"/>
                                <DataGridTextColumn Header="Run" Binding="{Binding RunLabel}" Width="100"/>
                                <DataGridTextColumn Header="Cell" Binding="{Binding CellNumber}" Width="50"/>
                                <DataGridTextColumn Header="Zygosity" Binding="{Binding Zygosity}" Width="100"/>
                                <DataGridTextColumn Header="IS" Binding="{Binding IS}" Width="40"/>
                                <DataGridTextColumn Header="37°C" Binding="{Binding C37}" Width="45"/>
                                <DataGridTextColumn Header="AHG" Binding="{Binding AHG}" Width="45"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Pattern Matches">
                <DataGrid ItemsSource="{Binding PatternRows}" IsReadOnly="True"
                          AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Antibody" Binding="{Binding Antibody}" Width="*"/>
                        <DataGridTextColumn Header="Matches" Binding="{Binding Matches}" Width="80"/>
                        <DataGridTextColumn Header="Mismatches" Binding="{Binding Mismatches}" Width="90"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Combinations">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="6,6,6,4"
                               Text="Antibody pairs where the combination score exceeds 50% — suggesting both antibodies may be present together."
                               TextWrapping="Wrap" Foreground="#555" FontStyle="Italic"/>
                    <DataGrid ItemsSource="{Binding CombinationRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Antibody Pair" Binding="{Binding Antibodies}" Width="*"/>
                            <DataGridTextColumn Header="Individual Scores" Binding="{Binding IndividualScores}" Width="140"/>
                            <DataGridTextColumn Header="Combination Score" Binding="{Binding CombinationScore}" Width="130"/>
                            <DataGridTextColumn Header="Both +" Binding="{Binding BothSupport}" Width="65"/>
                            <DataGridTextColumn Header="Ab1 Only" Binding="{Binding Ab1Only}" Width="75"/>
                            <DataGridTextColumn Header="Ab2 Only" Binding="{Binding Ab2Only}" Width="75"/>
                            <DataGridTextColumn Header="Neither" Binding="{Binding Neither}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Dosage">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="6,6,6,4"
                               Text="Homozygous vs heterozygous reaction strength for suspected antibodies."
                               TextWrapping="Wrap" Foreground="#555" FontStyle="Italic"/>
                    <DataGrid ItemsSource="{Binding DosageRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Antibody" Binding="{Binding Antibody}" Width="*"/>
                            <DataGridTextColumn Header="Antigen" Binding="{Binding Antigen}" Width="80"/>
                            <DataGridTextColumn Header="Homo avg" Binding="{Binding AvgHomozygous}" Width="90"/>
                            <DataGridTextColumn Header="Het avg" Binding="{Binding AvgHeterozygous}" Width="90"/>
                            <DataGridTextColumn Header="Homo n" Binding="{Binding HomozygousCount}" Width="70"/>
                            <DataGridTextColumn Header="Het n" Binding="{Binding HeterozygousCount}" Width="70"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Special Panels">
                <ScrollViewer>
                    <StackPanel Margin="8">
                        <TextBlock Text="Gated Rule-outs" FontWeight="Bold" FontSize="14"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="These rule-outs were suppressed because the antigen is destroyed by the cell treatment used."
                                   FontStyle="Italic" Foreground="#555" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding GatedRuleoutRows}" IsReadOnly="True"
                                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" MaxHeight="180" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Antibody" Binding="{Binding Antibody}" Width="100"/>
                                <DataGridTextColumn Header="Treatment" Binding="{Binding TreatmentLabel}" Width="140"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Treatment Inferences" FontWeight="Bold" FontSize="14"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Clinical interpretations derived from comparing treated vs untreated runs."
                                   FontStyle="Italic" Foreground="#555" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding TreatmentInferenceRows}" IsReadOnly="True"
                                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" MaxHeight="180" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Run" Binding="{Binding RunLabel}" Width="140"/>
                                <DataGridTextColumn Header="Antibody" Binding="{Binding Antibody}" Width="100"/>
                                <DataGridTextColumn Header="Observation" Binding="{Binding Observation}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Absorption Conclusions" FontWeight="Bold" FontSize="14"
                                   Margin="0,0,0,4"/>
                        <DataGrid ItemsSource="{Binding AbsorptionConclusionRows}" IsReadOnly="True"
                                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Absorption" Binding="{Binding AbsorptionLabel}" Width="160"/>
                                <DataGridTextColumn Header="Absorbed Out" Binding="{Binding AbsorbedOut}" Width="*"/>
                                <DataGridTextColumn Header="Surviving" Binding="{Binding Surviving}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Summary">
                <ScrollViewer>
                    <TextBox Text="{Binding SummaryText, Mode=OneWay}"
                             IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                             TextWrapping="Wrap" Margin="6"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
